.detail {
  background: linear-gradient(180deg, var(--line) 0%, var(--bg) 30%, var(--bg) 100%);
  padding: 24rpx 24rpx 40rpx;
}

.hero { position: relative; margin-bottom: 8rpx; }
.auto-btn {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.5);
  color: var(--surface);
  font-size: 22rpx;
  z-index: 6;
}
.auto-btn.on { background: rgba(14, 127, 115, 0.85); }

/* ---------- 创作者 ---------- */
.maker {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  margin: 18rpx 8rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}
.maker-ava {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  background: var(--line);
  flex-shrink: 0;
}
.maker-ava-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}
.m-ava-img { width: 100%; height: 100%; display: block; }
.maker-name { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.maker-sub { margin-top: 6rpx; font-size: 21rpx; color: var(--sub); }

/* ---------- 操作 ---------- */
.acts {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 20rpx 8rpx 0;
}
.act {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 26rpx;
  background: var(--surface);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: var(--sub);
  border: 1rpx solid var(--line);
}
.act.on { background: #fdf0f0; color: #d9534f; border-color: #f2c7c4; }
.act.ghost { background: #fff; }
.act.danger { color: #d9534f; }
.act:active { transform: scale(0.94); }

/* ---------- 预留长文本 ---------- */
.note {
  background: var(--surface);
  border-radius: 22rpx;
  margin: 20rpx 8rpx 0;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}
.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.note-t { font-size: 27rpx; font-weight: 700; color: var(--accent); }
.note-badge {
  font-size: 19rpx;
  color: var(--accent-2);
  border: 1rpx solid var(--accent-soft);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #edf7fb;
}
.note-body {
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--ink);
  background: var(--line);
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  border-left: 8rpx solid var(--accent-soft);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ---------- 留言输入 ---------- */
.compose {
  background: var(--surface);
  border-radius: 22rpx;
  margin: 20rpx 8rpx 0;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}
.compose-title { font-size: 26rpx; font-weight: 700; color: var(--ink); margin-bottom: 16rpx; }
.compose-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 150rpx;
  background: var(--line);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.ph { color: var(--sub); }
.compose-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.compose-len { font-size: 21rpx; color: var(--sub); margin-right: 20rpx; }
.send-btn {
  padding: 14rpx 40rpx;
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  color: #fff;
  border-radius: 40rpx;
  font-size: 25rpx;
  font-weight: 700;
}
.send-btn:active { opacity: 0.88; transform: scale(0.96); }

/* ---------- 留言列表 ---------- */
.msgs { margin: 26rpx 8rpx 0; }
.msgs-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
}
.msgs-t { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.msgs-count {
  margin-left: 14rpx;
  min-width: 36rpx;
  text-align: center;
  background: var(--accent-2);
  color: #fff;
  font-size: 20rpx;
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
}

.msg-empty {
  text-align: center;
  color: var(--sub);
  font-size: 24rpx;
  padding: 40rpx 0 30rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.msg-ava {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  background: var(--line);
}
.msg-main { flex: 1; min-width: 0; }
.msg-top {
  display: flex;
  align-items: baseline;
  margin-bottom: 6rpx;
}
.msg-name { font-size: 24rpx; font-weight: 700; color: var(--sub); }
.msg-time { font-size: 19rpx; color: var(--sub); margin-left: 14rpx; }
.msg-bubble {
  display: inline-block;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 4rpx 18rpx 18rpx 18rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-all;
}

.msg-row.mine { flex-direction: row-reverse; }
.msg-row.mine .msg-ava { margin-right: 0; margin-left: 18rpx; }
.msg-row.mine .msg-top { justify-content: flex-end; }
.msg-row.mine .msg-bubble {
  background: var(--line);
  border-color: var(--accent-soft);
  border-radius: 18rpx 4rpx 18rpx 18rpx;
  text-align: left;
}
.msg-row.mine .msg-main { display: flex; flex-direction: column; align-items: flex-end; }

.footer-gap { height: 60rpx; }

/* ---------- 首屏操作（收藏 + 去评论） ---------- */
.hero-actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 16rpx 0;
}
.hact {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 46rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  transition: transform 0.15s ease, opacity 0.2s ease;
}
.hact:active { transform: scale(0.97); }
.hact.like {
  background: var(--surface);
  border: 2rpx solid var(--accent-soft);
  color: var(--accent);
}
.hact.like.on {
  background: #fff2f2;
  border-color: #ffd0d0;
  color: #f25f6a;
}
.hact.primary {
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  color: #fff;
  box-shadow: 0 8rpx 22rpx rgba(14, 163, 173, 0.3);
}
.hact.icon {
  flex: 0 0 116rpx;
  font-size: 34rpx;
  background: var(--surface);
  border: 2rpx solid var(--accent-soft);
  color: var(--accent);
}
.hact.busy { opacity: 0.5; }

/* 离屏导出画布：不参与布局、不可见 */
.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  z-index: -1;
  pointer-events: none;
}

/* ============ 选择要导出的图片 ============ */
.pk-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 900;
  animation: fadeIn 0.2s ease both;
}
.pk-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 950;
  background: var(--surface);
  border-radius: 30rpx 30rpx 0 0;
  padding: 26rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(15, 23, 42, 0.2);
  transform: translateY(110%);
  transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
}
.pk-sheet.show { transform: translateY(0); }
.pk-head { position: relative; }
.pk-title { font-size: 32rpx; font-weight: 800; color: var(--accent); }
.pk-sub { margin-top: 6rpx; font-size: 21rpx; color: var(--sub); }
.pk-close {
  position: absolute;
  right: 0; top: 0;
  width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  background: var(--line); color: var(--sub);
  border-radius: 50%; font-size: 22rpx;
}
.pk-quick { display: flex; gap: 26rpx; margin: 16rpx 0 8rpx; }
.pk-link { font-size: 22rpx; color: var(--accent); }
.pk-scroll { margin-top: 8rpx; }
.pk-grid { display: flex; flex-wrap: wrap; gap: 14rpx; padding-bottom: 8rpx; }
.pk-item {
  position: relative;
  width: 31.5%;
  border-radius: 16rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  transition: border-color 0.15s ease, transform 0.15s ease;
}
.pk-item.on { border-color: var(--accent); transform: scale(0.98); }
.pk-img { width: 100%; height: 150rpx; display: block; background: var(--line); }
.pk-num {
  position: absolute;
  left: 8rpx; bottom: 8rpx;
  min-width: 32rpx;
  text-align: center;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: rgba(15, 23, 42, 0.55);
  color: #fff;
  font-size: 18rpx;
}
.pk-check {
  position: absolute;
  right: 8rpx; top: 8rpx;
  width: 38rpx; height: 38rpx; line-height: 38rpx; text-align: center;
  border-radius: 50%;
  background: var(--accent);
  color: var(--surface);
  font-size: 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.3);
}
.pk-foot { display: flex; gap: 18rpx; margin-top: 18rpx; }
.pk-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 46rpx;
  font-size: 26rpx;
  font-weight: 700;
}
.pk-btn.primary { background: var(--accent); color: var(--surface); }
.pk-btn.ghost { background: var(--line); color: var(--ink); }
.scroll-hint {
  margin: 18rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--sub);
  animation: hintFloat 1.6s ease-in-out infinite;
}
@keyframes hintFloat {
  0%, 100% { transform: translateY(0); opacity: 0.8; }
  50% { transform: translateY(6rpx); opacity: 0.4; }
}

/* 下滑后次要操作更克制 */
.acts { justify-content: flex-end; margin-top: 16rpx; }
.acts .act { padding: 12rpx 24rpx; font-size: 23rpx; }

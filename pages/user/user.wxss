.userpage {
  background: linear-gradient(180deg, var(--line) 0%, var(--bg) 32%, var(--bg) 100%);
  padding-bottom: 120rpx;
}

/* 异常提示：宁可显示一句话，也不要白屏 */
.u-err {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--sub);
  font-size: 24rpx;
}

/* 用户信息卡 */
.u-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 30rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  box-shadow: 0 14rpx 30rpx -12rpx rgba(15, 23, 42, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}
.u-orn { position: absolute; border-radius: 50%; pointer-events: none; }
.u-orn.uo-a {
  right: -70rpx; top: -80rpx;
  width: 240rpx; height: 240rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.22) 0 30%, transparent 46%);
}
.u-orn.uo-b {
  left: -40rpx; bottom: -70rpx;
  width: 170rpx; height: 170rpx;
  border: 14rpx solid rgba(255, 255, 255, 0.08);
}
.u-ava {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  background: var(--line);
}
.u-ava-img { width: 100%; height: 100%; display: block; }
.u-ava-txt {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 46rpx;
  font-weight: 700;
}
.u-info { margin-left: 24rpx; min-width: 0; flex: 1; position: relative; z-index: 1; }
.u-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.u-id { margin-top: 6rpx; font-size: 21rpx; color: rgba(255, 255, 255, 0.7); }
.u-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 18rpx;
  border-radius: 24rpx;
  font-size: 19rpx;
  color: #e8fbff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}
.u-self {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #05352e;
  background: rgba(255, 255, 255, 0.85);
}

/* 统计 */
.u-stats {
  display: flex;
  margin: 20rpx 24rpx 0;
  background: var(--surface);
  border-radius: 22rpx;
  padding: 24rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 12rpx 26rpx -12rpx rgba(15, 23, 42, 0.25), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}
.u-stat { flex: 1; display: flex; flex-direction: column; text-align: center; }
.u-stat + .u-stat { border-left: 2rpx solid var(--line); }
.us-v { font-size: 40rpx; font-weight: 800; color: var(--accent); }
.us-l { margin-top: 6rpx; font-size: 21rpx; color: var(--sub); }

.u-title {
  display: flex;
  align-items: baseline;
  margin: 28rpx 32rpx 8rpx;
}
.ut-main { font-size: 32rpx; font-weight: 800; color: var(--ink); }
.ut-sub { margin-left: 14rpx; font-size: 21rpx; color: var(--sub); }

/* 作品网格（与首页一致的瀑布流列） */
.grid { display: flex; align-items: flex-start; gap: 20rpx; padding: 0 24rpx; }
.mcol { flex: 1; min-width: 0; }
.mcell { margin-bottom: 24rpx; }
.cell-inner { position: relative; }
.cell-meta {
  margin-top: 10rpx;
  padding-left: 6rpx;
  font-size: 20rpx;
  color: var(--sub);
}

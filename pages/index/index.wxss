.index { padding-bottom: 320rpx; }

.masthead {
  position: relative;
  overflow: hidden;
  padding: 44rpx 32rpx 16rpx;
}
.brand-row { position: relative; display: flex; align-items: baseline; z-index: 1; }
.brand { font-size: 48rpx; font-weight: 800; letter-spacing: 2rpx; color: var(--accent); }
.brand-mark { font-size: 23rpx; color: var(--sub); margin-left: 14rpx; }
.brand-dice {
  position: relative;
  z-index: 1;
  display: inline-block;
  margin-top: 18rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--accent);
  background: var(--surface);
  border: 2rpx solid var(--accent-soft);
  box-shadow: 0 6rpx 14rpx -6rpx rgba(15, 23, 42, 0.25), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}
.brand-dice:active { transform: translateY(1rpx) scale(0.97); }

/* 艺术装饰：圆环 / 圆点 / 印章 */
.orn { position: absolute; pointer-events: none; }
.orn-ring-a {
  right: 60rpx; top: -44rpx;
  width: 210rpx; height: 210rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(15, 174, 190, 0.15) 0 26%, rgba(255, 255, 255, 0.9) 27% 30%, rgba(15, 174, 190, 0.08) 31% 54%, transparent 55%);
}
.orn-ring-b {
  left: -50rpx; bottom: -70rpx;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(99, 102, 241, 0.10) 0 30%, transparent 46%);
}
.orn-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: rgba(15, 174, 190, 0.5);
}
.orn-dot.dot-a { left: 36rpx; top: 30rpx; }
.orn-dot.dot-b { right: 150rpx; top: 62rpx; width: 10rpx; height: 10rpx; background: rgba(251, 191, 36, 0.6); }
.orn-stamp {
  right: 130rpx; top: 12rpx;
  font-size: 30rpx;
  color: rgba(251, 191, 36, 0.65);
  transform: rotate(12deg);
}
.page.dark .orn-stamp { color: rgba(251, 191, 36, 0.55); }
.page.dark .orn-dot.dot-b { background: rgba(251, 191, 36, 0.55); }

/* ---------- 筛选面板 ---------- */
.filter-panel {
  margin: 22rpx 24rpx 0;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 20rpx 0 14rpx;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.06);
}
.fp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
}
.fp-title { font-size: 30rpx; font-weight: 800; color: var(--ink); }
.fp-reset {
  font-size: 22rpx;
  color: var(--accent);
  padding: 6rpx 18rpx;
  border: 1rpx solid var(--accent-soft);
  border-radius: 26rpx;
}

.fp-row { margin-top: 16rpx; padding: 0 26rpx; }
.fp-scroll { white-space: nowrap; }
.fp-inner { display: inline-flex; padding-right: 8rpx; }
.fchip {
  display: inline-flex;
  align-items: center;
  margin-right: 14rpx;
  padding: 10rpx 22rpx;
  background: var(--line);
  border-radius: 34rpx;
  font-size: 24rpx;
  color: var(--sub);
  transition: all 0.2s ease;
}
.fchip.on {
  background: var(--accent);
  color: #fff;
  font-weight: 700;
}
.fchip .fc-n {
  margin-left: 8rpx;
  font-size: 18rpx;
  background: rgba(0, 0, 0, 0.14);
  border-radius: 20rpx;
  padding: 0 10rpx;
}
.fchip.on .fc-n { background: rgba(255, 255, 255, 0.3); color: #fff; }
.fchip:active { transform: scale(0.94); }

.time-row {
  display: flex;
  align-items: center;
}
.tp {
  flex: 1;
  background: var(--line);
  border-radius: 30rpx;
  padding: 12rpx 0;
  text-align: center;
}
.tp.on { background: #d6f0f4; border: 1rpx solid var(--accent-soft); }
.tp-val { font-size: 25rpx; color: var(--sub); }
.tp.on .tp-val { color: var(--accent); font-weight: 700; }
.tp-sep { margin: 0 14rpx; color: var(--sub); }
.tp-clear {
  margin-left: 14rpx;
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  font-size: 22rpx;
  color: var(--sub);
}

/* ---------- 结果标题 ---------- */
.result-head {
  display: flex;
  align-items: baseline;
  margin: 28rpx 32rpx 6rpx;
}
.rh-main {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 1rpx;
}
.rh-sub { margin-left: 16rpx; font-size: 22rpx; color: var(--sub); }

/* ---------- 分组 ---------- */
.group { margin-top: 10rpx; }
.group-head {
  display: flex;
  align-items: baseline;
  margin: 18rpx 34rpx 14rpx;
}
.group-head .gl {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}
.group-head .gl::before {
  content: "▍";
  color: var(--accent);
  margin-right: 8rpx;
  font-weight: 800;
}
.group-head .gc { margin-left: 16rpx; font-size: 21rpx; color: var(--sub); }

.grid {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 0 24rpx;
}
@keyframes swapAin { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: none; } }
@keyframes swapBin { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: none; } }
.grid.swapA { animation: swapAin 0.3s ease both; }
.grid.swapB { animation: swapBin 0.3s ease both; }

/* 瀑布流两列：列内紧凑，不同比例之间不出现大空档 */
.mcol { flex: 1; min-width: 0; }
.mcell { margin-bottom: 24rpx; box-sizing: border-box; }

.cell-inner { position: relative; }
.cell-foot {
  margin-top: 10rpx;
  padding-left: 6rpx;
  font-size: 20rpx;
  color: var(--sub);
}
.cell-foot .cf-time,
.cell-foot .cf-loc {
  display: inline-block;
  margin-right: 14rpx;
  white-space: nowrap;
}

.fav {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.35);
  color: rgba(255, 255, 255, 0.95);
  font-size: 34rpx;
  z-index: 6;
  transition: background 0.2s ease;
}
.fav.on { background: rgba(255, 255, 255, 0.92); color: #e05d5d; }
.fav:active { transform: scale(0.9); }

.multi-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(15, 23, 42, 0.45);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* ---------- 标签详细筛选 ---------- */
.tagwrap { display: flex; align-items: center; }
.tagwrap .fp-scroll.flex-1 { flex: 1; min-width: 0; }
.fchip.opener {
  background: var(--surface);
  border: 2rpx dashed var(--accent-soft);
  color: var(--accent);
  font-weight: 700;
  flex-shrink: 0;
}
.tag-sel-n {
  margin-left: 8rpx;
  background: var(--accent);
  color: var(--surface);
  border-radius: 20rpx;
  padding: 0 10rpx;
  font-size: 18rpx;
}
.fchip.rm { padding-right: 18rpx; }
.tag-x { margin-left: 6rpx; font-size: 18rpx; opacity: 0.8; }

/* 详细标签筛选浮层 */
.tf-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 900;
  animation: fadeIn 0.2s ease both;
}
.tf-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 950;
  background: var(--surface);
  border-radius: 30rpx 30rpx 0 0;
  padding: 26rpx 28rpx 0;
  box-shadow: 0 -8rpx 40rpx rgba(15, 23, 42, 0.2);
  transform: translateY(110%);
  transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
}
.tf-sheet.show { transform: translateY(0); }
.tf-head { position: relative; flex-shrink: 0; }
.tf-title { font-size: 32rpx; font-weight: 800; color: var(--accent); }
.tf-sub { margin-top: 6rpx; font-size: 21rpx; color: var(--sub); }
.tf-close {
  position: absolute;
  right: 0; top: 0;
  width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  background: var(--line); color: var(--sub);
  border-radius: 50%; font-size: 22rpx;
}
.tf-scroll { margin-top: 18rpx; } /* 高度由 JS 测量设置 */
.tf-empty { text-align: center; color: var(--sub); font-size: 24rpx; padding: 60rpx 0; }
.tf-grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding-bottom: 12rpx; }
.tf-opt {
  display: flex; align-items: center;
  background: var(--line);
  border: 2rpx solid transparent;
  border-radius: 34rpx;
  padding: 12rpx 22rpx;
  color: var(--ink);
  transition: all 0.15s ease;
}
.tf-opt .tf-em { margin-right: 8rpx; font-size: 24rpx; }
.tf-opt .tf-tx { font-size: 25rpx; }
.tf-opt .tf-cn {
  margin-left: 10rpx; font-size: 18rpx; color: var(--sub);
  background: rgba(127, 127, 127, 0.15);
  border-radius: 20rpx; padding: 0 10rpx;
}
.tf-opt.on {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--surface);
}
.tf-opt.on .tf-cn { background: rgba(255, 255, 255, 0.25); color: var(--surface); }
.tf-ok { margin-left: 8rpx; font-weight: 800; }
.tf-foot {
  flex-shrink: 0;
  display: flex; gap: 18rpx;
  padding: 18rpx 0 calc(28rpx + env(safe-area-inset-bottom));
  margin-top: 12rpx;
  border-top: 1rpx solid var(--line);
}
.tf-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 46rpx;
  font-size: 27rpx;
  font-weight: 700;
}
.tf-btn.primary { background: var(--accent); color: var(--surface); }
.tf-btn.ghost { background: var(--line); color: var(--ink); }

<view
  wx:if="{{card && view}}"
  class="cv r-{{view.ratio}} s-{{view.style}} m-{{mode}} anim-popIn"
  bindtap="onTapCard"
>
  <view class="frame" style="{{bgStyle}}">
    <!-- 自定义背景时的可读性遮罩 -->
    <view wx:if="{{hasScrim}}" class="cv-scrim {{scrimDark ? 'dark' : ''}}"></view>
    <!-- 各风格的装饰层（CSS 按 .s-* 控制显隐） -->
    <view class="deco deco-tape"></view>
    <view class="deco deco-corner c-tl"></view>
    <view class="deco deco-corner c-br"></view>
    <view class="deco deco-sprocket s-l"></view>
    <view class="deco deco-sprocket s-r"></view>

    <!-- 照片主体：full 模式多图轮切，可选自动播放 -->
    <view class="shot">
      <swiper
        wx:if="{{mode === 'full' && shots.length > 1}}"
        class="swiper"
        circular="{{true}}"
        autoplay="{{autoplay}}"
        interval="2600"
        duration="500"
        current="{{current}}"
        bindchange="onSwiperChange"
        bindtouchstart="onSwiperTouch"
      >
        <swiper-item wx:for="{{shots}}" wx:key="index">
          <image class="shot-img" src="{{item}}" mode="aspectFill" lazy-load="{{true}}" />
        </swiper-item>
      </swiper>
      <image wx:else class="shot-img" src="{{shots[0]}}" mode="aspectFill" />

      <!-- 贴纸层：制作页可拖动 / 长按删除，其它页面为静态装饰 -->
      <view
        wx:for="{{stickers}}"
        wx:key="id"
        class="sticker {{skDragCur === index ? 'dragging' : ''}}"
        style="{{item.style}}"
        data-i="{{index}}"
        catchtouchstart="onStickerStart"
        catchtouchmove="onStickerMove"
        catchtouchend="onStickerEnd"
        catchtouchcancel="onStickerEnd"
        bindlongpress="onStickerLongPress"
      >{{item.emoji}}</view>

      <view wx:if="{{mood}}" class="mood-badge" style="{{mood.style}}">{{mood.emoji}} {{mood.text}}</view>

      <view wx:if="{{mode === 'full' && shots.length > 1}}" class="shot-badge">
        {{current + 1}} / {{shots.length}}
      </view>

      <view class="film-meta" wx:if="{{card.timeText && view.style === 'film'}}">
        {{card.timeText}}
      </view>

      <view class="shot-brand">✿ 咔嚓</view>
    </view>

    <!-- 标签说明栏 + 时间地点基础元素 -->
    <view class="caption">
      <view class="phrases">
        <view wx:for="{{lines}}" wx:key="id" class="phrase {{item.main ? 'main' : ''}}">
          <text wx:if="{{item.emoji}}" class="pe">{{item.emoji}}</text>
          <text class="pt">{{item.text}}</text>
        </view>
      </view>

      <view class="meta" wx:if="{{(card.timeText || card.locText) && mode === 'full'}}">
        <text wx:if="{{card.timeText}}" class="mi">🕰 {{card.timeText}}</text>
        <text wx:if="{{card.locText}}" class="mi">📍 {{card.locText}}</text>
      </view>
    </view>
  </view>
</view>

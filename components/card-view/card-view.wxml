<view
  wx:if="{{card && view}}"
  class="cv r-{{view.ratio}} s-{{view.style}} m-{{mode}} anim-popIn"
  bindtap="onTapCard"
>
  <view class="frame" style="{{bgStyle}}">
    <!-- 自定义背景时的可读性遮罩 -->
    <view wx:if="{{hasScrim}}" class="cv-scrim {{scrimDark ? 'dark' : ''}}"></view>
    <!-- 各风格的装饰层（CSS 按 .s-* 控制显隐） -->
    <view class="deco deco-tape"></view>
    <view class="deco deco-corner c-tl"></view>
    <view class="deco deco-corner c-br"></view>
    <view class="deco deco-sprocket s-l"></view>
    <view class="deco deco-sprocket s-r"></view>

    <!-- 照片主体：full 模式多图轮切，可选自动播放 -->
    <view class="shot">
      <swiper
        wx:if="{{mode === 'full' && card.photos.length > 1}}"
        class="swiper"
        circular="{{true}}"
        autoplay="{{autoplay}}"
        interval="2600"
        duration="500"
        current="{{current}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{card.photos}}" wx:key="index">
          <image class="shot-img" src="{{item}}" mode="aspectFill" lazy-load="{{true}}" />
        </swiper-item>
      </swiper>
      <image wx:else class="shot-img" src="{{card.photos[0]}}" mode="aspectFill" />

      <view wx:if="{{mode === 'full' && card.photos.length > 1}}" class="shot-badge">
        {{current + 1}} / {{card.photos.length}}
      </view>

      <view class="film-meta" wx:if="{{card.timeText && view.style === 'film'}}">
        {{card.timeText}}
      </view>

      <view class="shot-brand">✿ 咔嚓</view>
    </view>

    <!-- 快捷语说明栏 + 时间地点基础元素 -->
    <view class="caption">
      <view class="phrases">
        <view
          wx:for="{{card.phrases}}"
          wx:key="id"
          class="phrase {{index === 0 ? 'main' : ''}}"
          wx:if="{{index < posterLimit || mode === 'full'}}"
        >
          <text wx:if="{{item.emoji}}" class="pe">{{item.emoji}}</text>
          <text class="pt">{{item.text}}</text>
        </view>
      </view>

      <view class="meta" wx:if="{{(card.timeText || card.locText) && mode === 'full'}}">
        <text wx:if="{{card.timeText}}" class="mi">🕰 {{card.timeText}}</text>
        <text wx:if="{{card.locText}}" class="mi">📍 {{card.locText}}</text>
      </view>
    </view>
  </view>
</view>
